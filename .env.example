# CYBERFORGE ENVIRONMENT CONFIGURATION
# If you have a Supabase project, enter your Project URL and Anon Public Key below.
# If these are left blank, CyberForge runs in zero-configuration local mode with
# real-time cross-tab synchronization and pre-configured community members!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
